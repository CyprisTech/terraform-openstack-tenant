# Copy to env.tfvars (git-ignored) and adapt to your cloud.
external_network        = "public"
second_external_network = "transit"         # stage 04 only
second_external_cidr    = "10.10.0.0/22"    # stage 04 only
az                      = "nova"
image                   = "ubuntu-24.04"
flavor                  = "m1.small"         # with a local disk
flavor_nodisk           = "m1.small-nodisk"  # without local disk (boot from volume)
zone_name               = "it.example.org."
shared_zone_name        = "it-shared.example.org."
shared_security_group   = "baseline-ssh"     # stage 04 only
dns_nameservers         = ["9.9.9.9"]
