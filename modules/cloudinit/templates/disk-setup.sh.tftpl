#!/bin/sh
# Generated by terraform-openstack-tenant/modules/cloudinit.
# Formats ${device} only if it holds no file system and no partition table,
# then mounts it by label. Safe to run at every boot.
set -eu

dev="${device}"
label="${label}"
mountpoint="${mountpoint}"

waited=0
while [ ! -b "$dev" ]; do
  if [ "$waited" -ge ${wait_seconds} ]; then
    echo "disk-${key}: $dev did not appear within ${wait_seconds}s" >&2
    exit 1
  fi
  sleep 2
  waited=$((waited + 2))
done

if [ -n "$(blkid -o value -s PTTYPE "$dev" 2>/dev/null || true)" ]; then
  echo "disk-${key}: $dev holds a partition table, refusing to format it" >&2
  exit 1
fi

if [ -z "$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)" ]; then
  echo "disk-${key}: formatting $dev as ${filesystem} with label $label"
  mkfs.${filesystem} -L "$label" "$dev"
  udevadm settle
fi

mkdir -p "$mountpoint"
if ! mountpoint -q "$mountpoint"; then
  mount -o "${options}" "LABEL=$label" "$mountpoint"
fi
%{ if owner != null || group != null ~}
chown "${owner != null ? owner : ""}${group != null ? ":${group}" : ""}" "$mountpoint"
%{ endif ~}
%{ if mode != null ~}
chmod "${mode}" "$mountpoint"
%{ endif ~}
